  "build": {
    "appId": "app.coroslink",
    "productName": "CorosLink",
    "protocols": [
      {
        "name": "CorosLink Watch Faces",
        "schemes": [
          "coroslink"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "JunAkerBuilds",
      "repo": "CorosLink"
    },
    "icon": "build/icon.png",
    "afterPack": "scripts/after-pack.cjs",
    "beforePack": "scripts/before-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "scripts/coros-native-ble.py",
        "to": "ble/coros-native-ble.py"
      },
      {
        "from": "scripts/coros_ble_auth.py",
        "to": "ble/coros_ble_auth.py"
      },
      {
        "from": "scripts/coros-system-ble.py",
        "to": "ble/coros-system-ble.py"
      },
      {
        "from": "scripts/coros_ble_protocol.py",
        "to": "ble/coros_ble_protocol.py"
      },
      {
        "from": "scripts/coros_ble_route.py",
        "to": "ble/coros_ble_route.py"
      },
      {
        "from": "scripts/coros_ble_music.py",
        "to": "ble/coros_ble_music.py"
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!**/coros-watchface-compiler"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "dist-electron/watchfaceCompiler/**/*",
      "dist-electron/watchfaceTargets.js"
    ],
    "dmg": {
      "background": "dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
