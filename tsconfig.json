{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "next": ["./desktop/shims/next.ts"],
      "next/link": ["./desktop/shims/next-link.tsx"],
      "next/navigation": ["./desktop/shims/next-navigation.ts"],
      "next/image": ["./desktop/shims/next-image.tsx"],
      "next/dynamic": ["./desktop/shims/next-dynamic.tsx"],
      "next/server": ["./desktop/shims/next-server.ts"],
      "next/headers": ["./desktop/shims/next-headers.ts"]
    }
  },
  "include": ["src", "desktop", "scripts", "vite.config.mts", "vitest.config.mts"],
  "exclude": ["node_modules", "dist"]
}
